# =====================================================================
# FUNTOPIA — Environment Variables Template
# =====================================================================
# Duplicate this file to .env in the project root:
#   cp .env.example .env
#
# Replace the placeholder values below with your credentials.
# Do NOT commit your actual .env file or private keys to version control.
# Never expose Supabase service-role keys in frontend code!
# =====================================================================

VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_ENV=development

# 1. Main Championship Platform Supabase Project (Participant Kiosk, Games, Coins, Profiles)
# Found in Main Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Dedicated Guess Who? Supabase Project (Authoritative Game State, Projector Sync, Turns, Coordinators)
# Found in Guess Who Supabase Dashboard -> Project Settings -> API
VITE_GW_SUPABASE_URL=https://your-gw-project.supabase.co
VITE_GW_SUPABASE_ANON_KEY=your-gw-anon-key-here
