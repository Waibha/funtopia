# =====================================================================
# MADAGASCAR (Repository: FUNTOPIA) — Environment Variables Template
# =====================================================================
# Duplicate this file to .env in the project root:
#   cp .env.example .env
#
# Replace the placeholder values below with your credentials.
# Do NOT commit your actual .env file or private keys to version control.
# Never expose Supabase service-role keys in frontend code!
# =====================================================================

VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_ENV=development

# Supabase Public Anon Configuration
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
