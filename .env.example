# =====================================================================
# MADAGASCAR — Supabase Configuration Template
# =====================================================================
# Duplicate this file to .env in the project root:
#   cp .env.example .env
#
# Replace the placeholder values below with your Supabase project credentials.
# Do NOT commit your actual .env file or private keys to version control.
# =====================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Public) Key (safe to use in browser client applications)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
